[browser-option]
;配置浏览器,可选 Edge 或 Chrome
driver = Edge
;指定浏览器所在路径,不填则使用默认路径
EXE_PATH =

[script-option]
;是否自动过登录时的滑块验证(默认:True)
enableAutoCaptcha = True
;是否自动隐藏浏览器窗口(默认:False)
enableHideWindow = False
;是否展示赞赏码(默认:True)
showDonateCode = True
;是否用视觉模型自动处理课中安全验证(默认:False)
enableVlmCaptcha = True
;阿里云百炼 API Key
vlmApiKey = sk-ws-H.PRYXXEL.VwGy.MEQCIFfqaagNWheCu4jKtdREDQ37Ab7rZj23TB3otWi30B-lAiBoznlG1XtfOkf8vhtPIZW0QG2FH1Nd2R68_o_uj95G9w
;视觉模型名称
vlmModel = qwen3.8-flash
;视觉模型接口地址(百炼专属版MaaS端点)
vlmBaseUrl = https://ws-oaxmwxmw6n35r8la.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
;视觉模型请求超时(秒),思考模型建议>=120
vlmTimeout = 120
;是否开启深度思考(思考模型较慢,验证码识别一般关闭)
vlmEnableThinking = False

[course-option]
;限制每门课程刷课时长/min (不限制:0)
limitMaxTime = 50
;限定播放倍速 (最高:1.8)
limitSpeed = 1.5
;设置是否静音播放 (默认:True)
soundOff = True

